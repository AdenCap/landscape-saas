{
  "version": 2,
  "buildCommand": "sh vercel-build.sh",
  "outputDirectory": ".",
  "builds": [
    { "src": "api/wsgi.py", "use": "@vercel/python" }
  ],
  "rewrites": [
    { "source": "/static/:path*", "destination": "/staticfiles/:path*" },
    { "source": "/media/:path*", "destination": "/media/:path*" },
    { "source": "/(.*)", "destination": "/api/wsgi" }
  ],
  "functions": {
    "api/wsgi.py": { "maxDuration": 60 }
  }
}
