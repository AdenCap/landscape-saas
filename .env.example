# Copy this file to .env and fill in your values. Do not commit .env.
# .env is listed in .gitignore.

# ============================================================================
# REQUIRED: Django Core Settings
# ============================================================================

# Django secret key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
# In production, use a strong random key. Development uses a default insecure key.
DJANGO_SECRET_KEY=

# Debug mode: set to "False" or "0" in production
DJANGO_DEBUG=True

# Allowed hosts (comma-separated): e.g. "yourdomain.com,www.yourdomain.com"
# Leave empty in development, set in production
ALLOWED_HOSTS=

# CSRF trusted origins (comma-separated): e.g. "https://yourdomain.com,https://www.yourdomain.com"
# Required for HTTPS in production
CSRF_TRUSTED_ORIGINS=

# ============================================================================
# REQUIRED: Stripe Integration (Platform Subscriptions + Connect)
# ============================================================================

# Stripe API keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret from https://dashboard.stripe.com/webhooks
# Get this after creating webhook endpoint at /webhooks/stripe/
STRIPE_WEBHOOK_SECRET=

# Subscription price ID from Stripe Products (starts with price_)
# Create a recurring monthly subscription product in Stripe Dashboard
STRIPE_SUBSCRIPTION_PRICE_ID=

# Optional: Platform fee percentage on invoice payments (e.g. 2.5 for 2.5%)
# Set to 0 for no platform fee (current default)
STRIPE_CONNECT_APPLICATION_FEE_PERCENT=0

# Optional: Separate webhook secret for Connect events (if using separate endpoint)
# STRIPE_CONNECT_WEBHOOK_SECRET=

# ============================================================================
# OPTIONAL: Database (PostgreSQL/Postgres)
# ============================================================================

# PostgreSQL connection string (if using Postgres instead of SQLite)
# Format: postgresql://user:password@host:port/database
# For Supabase: use the connection pooler URL (port 6543)
DATABASE_URL=

# Alternative Supabase URLs
# SUPABASE_URL=
# SUPABASE_DATABASE_URL=

# ============================================================================
# OPTIONAL: QuickBooks Online Integration
# ============================================================================

# Get these from https://developer.intuit.com/app/developer/dashboard
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Optional: Override callback URL (default is built from request)
# QUICKBOOKS_REDIRECT_URI=https://yourdomain.com/quickbooks/callback/

# ============================================================================
# OPTIONAL: File Storage (Vercel Blob)
# ============================================================================

# Vercel Blob storage token (if using Vercel Blob for file uploads)
# Get from Vercel Dashboard → Storage → Blob
# BLOB_READ_WRITE_TOKEN=

# ============================================================================
# OPTIONAL: Maps & Location Services
# ============================================================================

# Mapbox access token for Property Estimator satellite imagery
# Get free token at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# Google Maps API key for Daily Routes (map view, geocoding, directions)
# Enable Maps JavaScript API, Geocoding API, and Directions API
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# ============================================================================
# DEPLOYMENT: Vercel (auto-detected)
# ============================================================================

# Vercel automatically sets this, no need to set manually
# VERCEL=
