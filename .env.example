# Copy this file to .env and fill in your values. Do not commit .env.
# .env is listed in .gitignore.

# ============================================================================
# REQUIRED: Django Core Settings
# ============================================================================

# Django secret key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
# In production, use a strong random key. Development uses a default insecure key.
DJANGO_SECRET_KEY=

# Debug mode: set to "False" or "0" in production
DJANGO_DEBUG=True

# Allowed hosts (comma-separated): e.g. "yourdomain.com,www.yourdomain.com"
# Leave empty in development, set in production
ALLOWED_HOSTS=

# CSRF trusted origins (comma-separated): e.g. "https://yourdomain.com,https://www.yourdomain.com"
# Required for HTTPS in production
CSRF_TRUSTED_ORIGINS=

# ============================================================================
# REQUIRED: Stripe Integration (Platform Subscriptions + Connect)
# ============================================================================

# Stripe API keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret from https://dashboard.stripe.com/webhooks
# Get this after creating webhook endpoint at /webhooks/stripe/
STRIPE_WEBHOOK_SECRET=

# Subscription price IDs from Stripe Products (starts with price_)
# Pro All-Access monthly recurring price
STRIPE_SUBSCRIPTION_PRICE_ID=
# Solo Starter monthly recurring price
STRIPE_SUBSCRIPTION_PRICE_ID_SOLO=

# Optional trial lengths (days) for checkout subscription creation
# Defaults: Solo=7, Pro=14 if omitted
STRIPE_TRIAL_DAYS_SOLO=7
STRIPE_TRIAL_DAYS_PRO=14

# Marketing pricing display (optional; defaults in code)
PLATFORM_SOLO_PRICE=29.99
PLATFORM_PRO_PRICE=99.99
PLATFORM_CREW_SOFT_CAP=12

# Optional: Platform fee percentage on invoice payments (e.g. 2.5 for 2.5%)
# Set to 0 for no platform fee (current default)
STRIPE_CONNECT_APPLICATION_FEE_PERCENT=0

# Optional: Separate webhook secret for Connect events (if using separate endpoint)
# STRIPE_CONNECT_WEBHOOK_SECRET=

# ============================================================================
# REQUIRED IN PRODUCTION: Database (PostgreSQL/Supabase)
# ============================================================================

# Production runtime (DigitalOcean App Platform/Render/etc.) requires PostgreSQL.
# Use Supabase pooler URL (port 6543) and set one of these:
PG_URL=
# POSTGRES_URL=
# DATABASE_URL=

# Alternative Supabase aliases (optional)
# SUPABASE_URL=
# SUPABASE_DATABASE_URL=

# ============================================================================
# OPTIONAL: Supabase Realtime (for in-app messaging push notifications)
# ============================================================================

# Get from Supabase Dashboard -> Settings -> API
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=

# ============================================================================
# OPTIONAL: Google OAuth (Sign in with Google + Gmail sending)
# ============================================================================

# Get these from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Required for "Continue with Google" login and Gmail OAuth email sending.
# Add authorized redirect URI: https://yourdomain.com/accounts/social/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional separate iOS OAuth client ID for native Google Sign-In identity tokens.
GOOGLE_IOS_CLIENT_ID=

# ============================================================================
# OPTIONAL: Apple Sign-In (native iOS login)
# ============================================================================

# Service/client ID used as the expected audience for Apple identity tokens.
APPLE_CLIENT_ID=
# Optional separate iOS client ID if it differs from APPLE_CLIENT_ID.
APPLE_IOS_CLIENT_ID=

# ============================================================================
# OPTIONAL: QuickBooks Online Integration
# ============================================================================

# Get these from https://developer.intuit.com/app/developer/dashboard
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Optional: Override callback URL (default is built from request)
# QUICKBOOKS_REDIRECT_URI=https://yourdomain.com/quickbooks/callback/

# ============================================================================
# OPTIONAL: File Storage (Vercel Blob)
# ============================================================================

# Vercel Blob storage token (if using Vercel Blob for file uploads)
# Get from Vercel Dashboard → Storage → Blob
# BLOB_READ_WRITE_TOKEN=

# ============================================================================
# OPTIONAL: Maps & Location Services
# ============================================================================

# Mapbox access token for Property Estimator satellite imagery
# Get free token at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# Google Maps API key for Daily Routes (map view, geocoding, directions)
# Enable Maps JavaScript API, Geocoding API, and Directions API
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# ============================================================================
# OPTIONAL: Redis Cache / Celery / Background Jobs
# ============================================================================

# Redis (Upstash, DO Managed Redis, etc.)
REDIS_URL=
# Optional cache alias; defaults to REDIS_URL when set
# CACHE_URL=
CACHE_TIMEOUT_SECONDS=300

# Celery broker/result backend (defaults to REDIS_URL)
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TASK_DEFAULT_QUEUE=default

# ============================================================================
# OPTIONAL: Monitoring / Error Reporting (Sentry)
# ============================================================================

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_ENVIRONMENT=production

# ============================================================================
# OPTIONAL: Diagnostics endpoint hardening
# ============================================================================

# /api/db-check/ is disabled in production unless this is true.
DB_CHECK_ENABLED=0
DB_CHECK_SECRET=

# ============================================================================
# DEPLOYMENT: Vercel (auto-detected)
# ============================================================================

# Vercel automatically sets this, no need to set manually
# VERCEL=
