# Copy this file to .env and fill in your values. Do not commit .env.
# .env is listed in .gitignore.

# QuickBooks Online (from developer.intuit.com)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Optional: override callback URL (default is built from request)
# QUICKBOOKS_REDIRECT_URI=https://yourdomain.com/quickbooks/callback/

# Optional: Mapbox for Property Estimator satellite imagery
# MAPBOX_ACCESS_TOKEN=

# Stripe (dashboard.stripe.com → Developers → API keys, Webhooks)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
# Optional: platform fee % on invoice payments (e.g. 2.5)
# STRIPE_CONNECT_APPLICATION_FEE_PERCENT=0
